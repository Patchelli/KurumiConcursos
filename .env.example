POSTGRES_DB=kurumi_concursos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
ASPNETCORE_ENVIRONMENT=Production
ACTIVE_SWAGGER=false
JWT_ISSUER=KurumiConcursos
JWT_AUDIENCE=KurumiConcursos.Web
JWT_KEY=replace-with-a-long-random-production-secret
JWT_DURATION_MINUTES=480
JWT_REQUIRE_HTTPS_METADATA=true
FRONT_WEB=https://app.example.com
FRONT_MOBILE=https://mobile.example.com
CORS_ADDITIONAL_ORIGIN=
NEXTCLOUD_URL=https://nextcloud.example.com
NEXTCLOUD_USER=kurumi-integration
NEXTCLOUD_APP_PASSWORD=generate-an-app-password-in-nextcloud
NEXTCLOUD_ROOT_PATH=/Kurumi
NEXTCLOUD_TIMEOUT_SECONDS=120
PRIVATE_MATERIALS_USERS=person1@example.com,person2@example.com,person3@example.com
