{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnvironmentConfiguration": {
    "ActiveSwagger": "{{EnvironmentConfiguration.ActiveSwagger}}"
  },
  "ConnectionStrings": {
    "DefaultConnection": "{{ConnectionStrings.DefaultConnection}}"
  },
  "Jwt": {
    "JwtKey": "{{Jwt.JwtKey}}",
    "Issuer": "{{Jwt.Issuer}}",
    "Audience": "{{Jwt.Audience}}",
    "DurationInMinutes": "{{Jwt.DurationInMinutes}}",
    "RequireHttpsMetadata": "{{Jwt.RequireHttpsMetadata}}"
  },
  "CorsConfiguration": {
    "Web": "{{CorsConfiguration.Web}}",
    "Mobile": "{{CorsConfiguration.Mobile}}",
    "Methods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ]
  }
}
